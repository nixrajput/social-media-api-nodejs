{
  "name": "social-media-api",
  "version": "2.1.0",
  "author": "Nikhil Rajput",
  "license": "MIT",
  "description": "An open-source RESTful API developed using NodeJS, ExpressJS and MongoDB helps you to integrate User Authentication and Social Media Post Management in your application with ease.",
  "main": "dist/src/index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "start": "bun dist/src/index.js",
    "clean": "rimraf -rf dist",
    "build": "echo \"✅ Building project...\" && bun run clean && tsc",
    "ts:check": "tsc --project tsconfig.json",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "test": "bun test",
    "push": "git add -A && git commit -m \"Update Changes & Bug Fixes\" && git push origin master"
  },
  "pre-commit": [
    "ts:check",
    "build"
  ],
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/body-parser": "1.19.6",
    "@types/bun": "1.4.5",
    "@types/compression": "1.8.1",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/lodash": "4.17.27",
    "@types/morgan": "1.9.10",
    "@types/node": "26.6.6",
    "@types/otp-generator": "4.0.2",
    "@types/swagger-jsdoc": "6.0.4",
    "@types/swagger-ui-express": "4.1.8",
    "@typescript-eslint/eslint-plugin": "8.74.0",
    "@typescript-eslint/parser": "8.74.0",
    "eslint": "10.15.0",
    "pre-commit": "2.0.0",
    "rimraf": "6.1.4",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "@getbrevo/brevo": "6.2.0",
    "@sendgrid/mail": "8.1.6",
    "axios": "1.21.1",
    "body-parser": "2.4.0",
    "cloudinary": "2.11.0",
    "compression": "1.8.2",
    "cors": "2.8.6",
    "express": "5.3.0",
    "express-rate-limit": "8.7.5",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "lodash": "4.18.1",
    "mongoose": "9.13.0",
    "morgan": "1.12.1",
    "node-cron": "4.6.0",
    "otp-generator": "4.0.1",
    "swagger-jsdoc": "6.3.0",
    "swagger-ui-express": "5.0.1",
    "url": "0.11.4",
    "winston": "3.19.0"
  },
  "overrides": {
    "glob": "14.0.6"
  },
  "engines": {
    "node": "26.x",
    "bun": ">=1.4"
  }
}
