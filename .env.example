NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://app:app@localhost:5432/social_dev
REDIS_URL=redis://localhost:6379
CORS_ORIGINS=
JWT_ACCESS_SECRET=change-me-at-least-16-chars
# Empty = OTP codes are logged to the console. For a local inbox UI, run Mailpit
# (brew install mailpit && brew services start mailpit) and use the URL below.
SMTP_URL=
# SMTP_URL=smtp://localhost:1025   # Mailpit; view mail at http://localhost:8025
MAIL_FROM=no-reply@localhost
# Comma-separated Google OAuth client IDs accepted as the ID-token audience
# (web + android + ios). Empty disables Google login outside tests.
GOOGLE_OAUTH_CLIENT_IDS=
